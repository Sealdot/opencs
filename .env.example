# Controlled billing integration preview; fill all empty values before --check.
# Do not commit .env or real secrets. The CLI reads exported env, not this file.
OPENCS_TENANT_ID=
CHATWOOT_BASE_URL=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_INBOX_ID=
CHATWOOT_TEAM_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_SIGNING_SECRET=
# assignment = private note + team; agent_bot adds explicit open.
# agent_bot requires the actual AgentBot token and a configured pending queue.
CHATWOOT_HANDOFF_MODE=assignment
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=
BILLING_CUSTOMER_URL=
BILLING_INVOICE_URL=
# HTTP permitted only by explicit opt-in; HTTPS verification stays enabled.
OPENCS_ALLOW_HTTP=0
OPENCS_HTTP_TIMEOUT_SECONDS=10
