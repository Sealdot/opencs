  "required": [
    "id",
    "tenant_id",
    "conversation_id",
    "state",
    "attempt",
    "version",
    "from",
    "to",
    "reason",
    "customer",
    "intent",
    "priority",
    "summary",
    "facts",
    "actions_completed",
    "actions_pending",
    "recommended_action",
    "evidence_refs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opencs:schema:handoff:0.0",
  "title": "OpenCS 0.0 handoff snapshot",
  "$comment": "D2/D3 structural baseline; persisted state and authority validated separately.",
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "accepted",
              "in_progress",
              "completed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
